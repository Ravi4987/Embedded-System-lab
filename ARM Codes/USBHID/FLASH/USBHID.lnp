--cpu Cortex-M3
".\flash\startup_lpc17xx.o"
".\flash\system_lpc17xx.o"
".\flash\timer.o"
".\flash\usbhw.o"
".\flash\usbuser.o"
".\flash\demo.o"
".\flash\hiduser.o"
".\flash\usbcore.o"
".\flash\usbdesc.o"
--strict --scatter ".\FLASH\USBHID.sct"
--summary_stderr --info summarysizes --map --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list ".\FLASH\USBHID.map" -o .\FLASH\USBHID.axf